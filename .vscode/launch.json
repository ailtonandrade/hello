{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Youtube Downloader",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/youtube_downloader.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run ComfyUI",
            "type": "debugpy",
            "request": "launch",
            "program": "../stable-difusion-image/ComfyUI/main.py",
            "args": ["--directml","--use-split-cross-attention"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "../stable-difusion-image/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Youtube Auth",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/get_youtube_token.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Otom Media Generator",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}"
        },
    ]
}