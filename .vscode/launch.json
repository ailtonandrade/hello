    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Youtube Downloader",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Youtube Auth",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/get_youtube_token.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Otomandrade Media Generator",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}"
        }
    ]
}